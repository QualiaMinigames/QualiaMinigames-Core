# Rust build artifacts
/target

# Editor / IDE
.vscode/
.idea/
*.iml

# Operating system
Thumbs.db
Desktop.ini
.DS_Store

# cargo-fuzz output. The two kinds are handled differently (see fuzz/.gitignore):
#
#   fuzz/target/           build artifacts, never committed
#   fuzz/artifacts/        crash inputs, useful only while the crash is investigated
#   fuzz/corpus/<target>/  seeds generated by running the fuzzer; not committed, because
#                          it is rewritten on every run and would turn each run into
#                          hundreds of meaningless changes. Inputs worth keeping are
#                          copied by hand into fuzz/regressions/<target>/, which is
#                          committed.
/fuzz/target
/fuzz/artifacts

# Local environment and keys
.env
*.local.toml
secrets/
